{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .nexus/progress.md ]; then echo 'Context was compacted. Current state from .nexus/progress.md:'; cat .nexus/progress.md; fi"
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "if [ -f .nexus/handoff.md ]; then echo 'Handoff from previous session (.nexus/handoff.md):'; cat .nexus/handoff.md; fi"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$HOME/.claude/hooks/detect_learning.py\" 2>/dev/null || python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/detect_learning.py\" 2>/dev/null || true"
          }
        ]
      }
    ]
  }
}